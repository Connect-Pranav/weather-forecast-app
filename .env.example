# Environment variables
# This file is for reference. The app requires no environment variables
# as all weather data is generated locally.

# Optional: API endpoint for future enhancements (not currently used)
# NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: Sentry error tracking (future enhancement)
# NEXT_PUBLIC_SENTRY_DSN=

# Optional: Analytics (future enhancement)
# NEXT_PUBLIC_ANALYTICS_ID=
